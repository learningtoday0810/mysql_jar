        if x_data[0] <= x_val <= x_data[-1]:
            x_values.append(x_val)
            break
        else:
            print("Incorrect interpolated value. Enter again.")
x = sp.Symbol('x')
h=[0]
for i in range (1,n):
    h.append(x_data[i]-x_data[i-1])
m = [0] * n
for i in range(1, n - 1):
    m[i] = sp.Symbol(f'm{i}')
equation = []
for i in range(1, n - 1):
    eq = (
        m[i - 1]
        + 4 * m[i]
        + m[i + 1]
        - (6 / h[i]**2) *
        (y_data[i + 1] - 2 * y_data[i] + y_data[i - 1])
    )
    equation.append(eq)
unknowns = m[1:n-1]
values = sp.solve(equation, unknowns)
for i in range(1, n - 1):
    m[i] = values[m[i]]
fx = []
for i in range(1, n):
    eq = (
        ((x_data[i] - x)**3 * m[i - 1]) / (6 * h[i])
        + ((x - x_data[i - 1])**3 * m[i]) / (6 * h[i])
        + ((x_data[i] - x) / h[i]) *
          (y_data[i - 1] - (h[i]**2 * m[i - 1]) / 6)
        + ((x - x_data[i - 1]) / h[i]) *
          (y_data[i] - (h[i]**2 * m[i]) / 6)
    )
    fx.append(sp.expand(eq))
