print("\nInitial Augmented Matrix:")
for row in aug:
    print(" ".join(f"{x:.3f}" for x in row))

for i in range(n):
    if aug[i][i] == 0:
        for k in range(i + 1, n):
            if aug[k][i] != 0:
                aug[i], aug[k] = aug[k], aug[i]
                break
        else:
            print("Inverse does not exist")
            exit()

    pivot = aug[i][i]

    for j in range(2 * n):
        aug[i][j] /= pivot

    for k in range(n):
        if k != i:
            factor = aug[k][i]
            for j in range(2 * n):
                aug[k][j] -= factor * aug[i][j]

    print(f"\nIteration {i+1}:")
    for row in aug:
        print(" ".join(f"{x:.3f}" for x in row))

print("\nInverse matrix:")
for i in range(n):
    print(" ".join(f"{aug[i][j]:.3f}" for j in range(n, 2 * n)))

