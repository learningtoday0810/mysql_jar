import numpy as np
import math

L = float(input("Enter the length of the string (L): "))
c = float(input("Enter the wave speed (c): "))
M = int(input("Enter the number of spatial intervals (M): "))
T = float(input("Enter the final time (T): "))
N = int(input("Enter the number of time intervals (N): "))

if L <= 0 or c <= 0 or M < 2 or T <= 0 or N < 1:
    print("Invalid input.")
    raise SystemExit

h = L / M
k = T / N
r = c * k / h

print("\nSpace step h =", h)
print("Time step k =", k)
print("Courant number r =", r)

if r > 1:
    print("Stability condition violated")
    raise SystemExit
else:
    print("Stability condition satisfied")

x = np.linspace(0, L, M + 1)

def f(x):
    return 0.01 * np.sin(np.pi * x / L)

def g(x):
    return 0.0

U = np.zeros((N + 1, M + 1))

# Initial condition
for i in range(M + 1):
    U[0, i] = f(x[i])

# First time level
for i in range(1, M):
    U[1, i] = (
        f(x[i])
        + k * g(x[i])
        + (r ** 2 / 2)
        * (
            f(x[i + 1])
            - 2 * f(x[i])
            + f(x[i - 1])
        )
    )

# Boundary conditions
U[:, 0] = 0.0
U[:, M] = 0.0

# Explicit finite difference iteration
for n in range(1, N):
    for i in range(1, M):
        U[n + 1, i] = (
            2 * (1 - r ** 2) * U[n, i]
            + r ** 2 * (U[n, i - 1] + U[n, i + 1])
            - U[n - 1, i]
        )

    U[n + 1, 0] = 0.0
    U[n + 1, M] = 0.0

mid = M // 2

print("\nInitial displacement:")
print(f"u({x[mid]:.4f}, 0) = {U[0, mid]:.6f}")

print("\nFirst time-level displacement:")
print(f"u({x[mid]:.4f}, {k:.6f}) = {U[1, mid]:.6f}")

print("\nFinal displacement at time T =", T)
print("x\t\tU(x,T)")

step = max(1, M // 10)

for i in range(0, M + 1, step):
    print(f"{x[i]:.4f}\t\t{U[N, i]:.6f}")

if M % step != 0:
    print(f"{x[M]:.4f}\t\t{U[N, M]:.6f}")

print("\nNumerical solution completed.")

